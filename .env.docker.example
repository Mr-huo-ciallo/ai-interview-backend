# Compose image and published endpoint
APP_IMAGE_TAG=local
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
TZ=Asia/Shanghai

# Generate both passwords with: openssl rand -hex 24
# Use hexadecimal values so DATABASE_URL does not require URL escaping.
MYSQL_DATABASE=ai_interview
MYSQL_USER=ai_interview
MYSQL_PASSWORD=replace_with_hex_password
MYSQL_ROOT_PASSWORD=replace_with_another_hex_password

# Generate with: openssl rand -hex 32
AUTH_SECRET=replace_with_long_random_secret
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO

# Required for AI-assisted features; leave empty only when rule-based fallback is acceptable.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
